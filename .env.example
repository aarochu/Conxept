# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/misconception
ENGINE_ADDR=http://localhost:50051
PORT=8080
# Needed only for Analyze (Deep Agent brief) and the model baseline. Either key works;
# OpenRouter's ":free" models cost nothing (list them with `make free-models`).
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Blank picks a default for the key that is set, e.g. openrouter:<model id>:free
AGENT_MODEL=
# Optional Wolfram cross-check; leave unset to skip
WOLFRAM_APP_ID=
