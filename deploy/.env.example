# Copy to deploy/.env. Use single quotes around URLs containing dollar signs.
# Pin both images to the same successfully published main commit.
IMAGE_TAG=
GATEWAY_DATABASE_URL=
ENGINE_DATABASE_URL=
GATEWAY_PORT=8080
# Analyze only. Either key works; OpenRouter ":free" models cost nothing.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
# Blank picks a default for the key that is set.
AGENT_MODEL=
# Optional Wolfram|Alpha cross-check of answer keys; leave blank to skip.
WOLFRAM_APP_ID=
